# Render supplies these to the single Free web service.
# GitHub Packages token with read:packages access, required by npm ci for the
# private @invisible-labs/sdk dependency.
NODE_AUTH_TOKEN=replace_with_github_packages_read_token
PORT=10000
TELEGRAM_BOT_TOKEN=replace_with_bot_token
# Generate locally with: openssl rand -hex 32
# Telegram accepts only A-Z, a-z, 0-9, _ and - in this value.
TELEGRAM_WEBHOOK_SECRET=replace_with_telegram_webhook_secret

# Render provides RENDER_EXTERNAL_URL automatically. The app registers
# https://<service>.onrender.com/telegram/webhook with Telegram at startup.
# BACKEND_API_TOKEN is generated by Render.

COORDINATOR_WS_URL=wss://your-coordinator-host/ws-noise
COORDINATOR_EXPECTED_HOSTNAME=your-coordinator-host
COORDINATOR_REQUIRED_MODE=prod
COORDINATOR_MRTD=replace_with_approved_mrtd
COORDINATOR_INTEL_ROOT_FINGERPRINT=replace_with_approved_intel_root_fingerprint

# Required when the coordinator's production attestation policy uses Azure MAA.
COORDINATOR_AZURE_MAA_ISSUER=https://your-maa-host
COORDINATOR_AZURE_MAA_JWKS_URL=https://your-maa-host/certs
COORDINATOR_AZURE_MAA_POLICY_HASH=replace_with_approved_policy_hash
