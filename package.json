{
  "name": "invisible-telegram",
  "version": "1.0.0",
  "description": "Classic Telegram bot example for Invisible private transfers.",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run dev:telegram",
    "dev:backend": "node --env-file=.env --watch --import=tsx src/backend/main.ts",
    "dev:telegram": "node --env-file=.env --watch --import=tsx src/main.ts",
    "dev:render": "node --env-file=.env --watch --import=tsx src/render-main.ts",
    "start:backend": "node dist/backend/main.js",
    "start:render": "node dist/render-main.js",
    "start:telegram": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:automation": "node --test --test-concurrency=1 scripts/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Invisible-Labs/invisible-telegram.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Invisible-Labs/invisible-telegram/issues"
  },
  "homepage": "https://github.com/Invisible-Labs/invisible-telegram#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@invisible-labs/sdk": "0.6.0-devnet.1-dev.114.1",
    "bs58": "^6.0.0",
    "express": "^5.2.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "nodemon": "^3.1.14",
    "prettier": "3.9.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
